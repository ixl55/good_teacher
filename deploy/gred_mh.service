[Unit]
Description=Student Grades Management System
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/gred_mh
Environment=HOST=0.0.0.0
Environment=PORT=5000
ExecStart=/usr/bin/python3 /home/pi/gred_mh/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
